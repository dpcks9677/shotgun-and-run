  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uACE0\uB9C8\uC6CC. \uC6B0\uB9AC\uB3C4 \uB124\uAC00 \uB3CC\uC544\uC624\uBA74
      \uC7AC\uC815\uBE44\uD560 \uC218 \uC788\uAC8C \uC900\uBE44\uD574 \uB458\uAC8C."
