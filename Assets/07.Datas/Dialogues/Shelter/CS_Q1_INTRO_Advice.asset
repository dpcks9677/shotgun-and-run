  _guideImage: {fileID: 0}
  _lines:
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uC654\uAD6C\uB098. \uC228\uC740 \uC880 \uB3CC\uB838\uC5B4?"
    Bubble: 0
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uBCF8\uB860\uBD80\uD130 \uB9D0\uD560\uAC8C. \uC544\uAE4C\uB3C4 \uB9D0\uD588\uB4EF\uC774
      \uC0C1\uD669\uC774 \uC88B\uC9C0 \uC54A\uC544. \uC6B0\uB9B0 \uC774 \uB358\uC804\uC5D0
      \uAC07\uD78C \uC2E0\uC138\uB2C8\uAE4C."
    Bubble: 0
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uC774 \uBB38 \uC55E\uC73C\uB85C \uC870\uAE08\uB9CC \uB098\uAC00\uBA74
      \uACE0\uBE14\uB9B0\uB4E4\uC774 \uB4DD\uC2E4\uAC70\uB824. \uBCF4\uAE09\uC774
      \uB2E4 \uB5A8\uC5B4\uC838\uC11C \uADFC\uCC98\uC5D0\uC11C \uB188\uB4E4\uC774
      \uBBF8\uCC98 \uBABB \uCC59\uAE34 \uAC83\uB4E4\uB85C \uC5F0\uBA85 \uC911\uC774\uC9C0."
    Bubble: 0
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uADF8\uB7F0\uB370 \uADF8 \uC544\uD2F0\uD329\uD2B8... \uADF8\uAC83\uB9CC
      \uC788\uC73C\uBA74 \uB188\uB4E4\uC744 \uCC98\uB9AC\uD560 \uC218 \uC788\uC744
      \uAC83 \uAC19\uC544. \uC544\uAE4C \uBCF4\uB2C8 \uD654\uB825\uC774 \uC7A5\uB09C
      \uC544\uB2C8\uB358\uB370?"
    Bubble: 7
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uADF8\uB798\uC11C \uB124\uAC8C \uB358\uC804 \uD0D0\uC0AC\uB97C \uB9E1\uAE30\uACE0
      \uC2F6\uC5B4. \uBA38\uB9BF\uC218\uAC00 \uB9CE\uB2E4 \uBCF4\uB2C8 \uC6B0\uB9AC\uC5D0\uAC90
      \uC555\uB3C4\uC801\uC778 \uD654\uB825\uC774 \uD544\uC694\uD574."
    Bubble: 4
    Sfx: {fileID: 0}
    Signal: 
  _choices:
  - ChoiceText: "\uC81C\uAC00 \uD574\uBCFC\uAC8C\uC694."
    ChoiceId: 
  _pauseGame: 0
