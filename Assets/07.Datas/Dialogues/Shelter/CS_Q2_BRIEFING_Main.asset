  _lines:
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uB3CC\uC544\uC654\uAD6C\uB098! \uBB34\uC0AC\uD574\uC11C \uB2E4\uD589\uC774\uC57C. "
    Bubble: 4
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uBCF4\uB2E4\uC2DC\uD53C \uACE0\uBE14\uB9B0\uB4E4\uC774 \uB358\uC804 \uC785\uAD6C\uB97C
      \uBB34\uB108\uB728\uB838\uC5B4. \uB188\uB4E4\uC5D0\uAC8C \uAC70\uC810\uC774
      \uBC1C\uAC01\uB41C \uBAA8\uC591\uC774\uC57C. "
    Bubble: 1
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uC5D8\uB808\uB098\uC758 \uACF5\uAC04 \uC774\uB3D9 \uB9C8\uBC95\uC774
      \uC788\uC73C\uBA74 \uB2E4\uC2DC \uAC08 \uC218 \uC788\uC744 \uAC83 \uAC19\uC740\uB370,
      \uB4DC\uC6CC\uD504 \uACF5\uBC29 \uCABD\uC744 \uC815\uCC30\uD558\uB7EC \uB098\uAC14\uB2E4\uAC00
      \uB188\uB4E4\uD55C\uD14C \uBD99\uC7A1\uD78C \uAC83 \uAC19\uC544."
    Bubble: 5
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3e96ec43bf27def45a8e154a18b0e6de, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uC5B4\uB5BB\uAC8C\uB4E0 \uB2E4\uC2DC \uB358\uC804\uC5D0 \uB4E4\uC5B4\uAC08
      \uBC29\uBC95\uC774 \uC5C6\uC744\uAE4C\uC694?"
    Bubble: 2
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uC74C... \uADF8\uB7EC\uBA74 \uC624\uB978\uCABD \uD1B5\uB85C\uB85C \uAC00.
      \uC881\uACE0 \uC704\uD5D8\uD558\uC9C0\uB9CC \uBD81\uC11C\uCABD \uC9C4\uC785\uB85C\uAE4C\uC9C0\uB294
      \uC774\uC5B4\uC838 \uC788\uC744 \uAC70\uC57C. "
    Bubble: 7
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uAC70\uAE30\uC11C \uB0A8\uCABD, \uB4DC\uC6CC\uD504 \uACF5\uBC29 \uAE38\uBAA9\uC758
      \uD070 \uD640\uC744 \uB458\uB7EC\uBD10. \uB9C8\uC9C0\uB9C9 \uD754\uC801\uC774
      \uAC70\uAE30\uC11C \uBC1C\uACAC\uB410\uC5B4."
    Bubble: 0
    Sfx: {fileID: 0}
    Signal: 
  - Speaker: {fileID: 11400000, guid: 3818475cc931b484face2032818805d0, type: 2}
    Expression: 
    SpeakerName: 
    SpeakerPortrait: {fileID: 0}
    Text: "\uB188\uB4E4\uC774 \uADF8\uB0E5 \uB450\uC9C4 \uC54A\uC558\uC744 \uAC70\uC57C.
      \uC870\uC2EC\uD558\uB3C4\uB85D \uD574."
    Bubble: 1
    Sfx: {fileID: 0}
    Signal: 
  _choices: []
  _pauseGame: 0
